actio dibujarCajaExtrema(esto ancho : numerus, esto alto : numerus, esto borde : textum) {
    per (esto fila : numerus = 0; fila < alto; fila++) {
        esto lineaStr : textum = "";
        per (esto col : numerus = 0; col < ancho; col++) {
            si (fila == 0 || fila == alto - 1 || col == 0 || col == ancho - 1) {
                lineaStr = lineaStr + borde;
