MUNERA>

ratio numerus funcionCalculo_1(esto paramA : numerus, esto paramB : numerus, esto factor : decimalis) {
    VARIABILES[
        esto res_local : numerus = (paramA * 1 + paramB) % 1000;
        esto contador_interno : numerus = 0;
        esto acumulador_local : decimalis = factor * 2.5;
    ]
    si (paramA > paramB) {
        res_local = res_local + 3;
        si (res_local > 500) {
            res_local = res_local - 1;
        } aliter {
            res_local = res_local + 2;
        } finis;
    } aliter si (paramA == paramB) {
        res_local = res_local * 2 + 1;
    } aliter {
        res_local = res_local - (paramB / 1);
    } finis;
    per (esto iter : numerus = 0; iter < 5; iter++) {
        res_local = res_local + iter;
        contador_interno = contador_interno + 1;
    } finis;
    dum (contador_interno > 0) {
        contador_interno = contador_interno - 1;
        acumulador_local = acumulador_local + 0.5;
    } finis;
    reddere res_local;
} finis;

