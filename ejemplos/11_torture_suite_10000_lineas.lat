# Función recursiva: Factorial con traza en consola
ratio numerus f_factorial(esto n : numerus) {
    VARIABILES[
        esto res : numerus = 1;
    ]
    si (n <= 1) {
        >> "   [RECURSIÓN FACTORIAL] Caso base alcanzado: n=" >> n;
        reddere 1;
    } finis;
    res = n * f_factorial(n - 1);
    >> "   [RECURSIÓN FACTORIAL] Retornando paso n=" >> n >> " -> res=" >> res;
    reddere res;
} finis;

# Función recursiva: Fibonacci con traza en consola
ratio numerus f_fibonacci(esto n : numerus) {
    VARIABILES[
        esto a : numerus = 0;
        esto b : numerus = 0;
    ]
    si (n <= 0) {
        reddere 0;
    } finis;
    si (n == 1) {
        reddere 1;
    } finis;
    a = f_fibonacci(n - 1);
    b = f_fibonacci(n - 2);
    reddere a + b;
} finis;

ratio decimalis f_calculo_modulo_1(esto val : decimalis, esto iter : numerus) {
    VARIABILES[
        esto res_1 : decimalis = val;
        esto idx : numerus = 0;
    ]
    dum (idx < iter) {
        res_1 = res_1 + (idx * 0.1) - 1;
        >> "   [DUM FN #1] Iterando idx=" >> idx >> " -> Val acumulado=" >> res_1;
        idx++;
    } finis;
    reddere res_1;
} finis;

