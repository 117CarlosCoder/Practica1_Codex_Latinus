##
=============================================================================
  CODEX LATINUS - EJEMPLO 09: MATRICES, SIMULACIONES Y ALGORITMOS
  Criba de Primos, Producto de Vectores, Cifrado y Algoritmo de Cambio
=============================================================================
##

# =========================================================================
# 1. SECCIÓN DE VARIABLES GLOBALES (VARIABILES>)
# =========================================================================
VARIABILES>
series vectorA[4] : numerus = {2, 4, 6, 8};
series vectorB[4] : numerus = {1, 3, 5, 7};
series cribaPrimos[20] : bool;
series monedasDenominaciones[5] : numerus = {50, 25, 10, 5, 1};


# =========================================================================
# 2. SECCIÓN DE FUNCIONES Y ALGORITMOS (MUNERA>)
# =========================================================================
MUNERA>

# 2.1. Producto Punto entre dos Vectores
ratio numerus productoPunto(esto tam : numerus) {
    VARIABILES[
        esto acumulador : numerus = 0;
    ]
    per (esto i : numerus = 0; i < tam; i++) {
        acumulador = acumulador + (vectorA[i] * vectorB[i]);
    } finis;
    reddere acumulador;
} finis;

# 2.2. Algoritmo Voraz (Greedy): Cálculo de Monedas para Cambio
actio calcularCambio(esto monto : numerus) {
    >> "Desglose de cambio para $" >> monto >> ":";
    esto restante : numerus = monto;
    per (esto i : numerus = 0; i < 5; i++) {
        esto moneda : numerus = monedasDenominaciones[i];
        esto cantidad : numerus = 0;
        dum (restante >= moneda) {
            cantidad++;
            restante = restante - moneda;
        } finis;
        si (cantidad > 0) {
            >> "  Monedas de $" >> moneda >> ": " >> cantidad;
        } finis;
    } finis;
} finis;

# 2.3. Criba de Eratóstenes para números del 0 al 19
actio inicializarCriba() {
    per (esto k : numerus = 0; k < 20; k++) {
        cribaPrimos[k] = verum;
    } finis;
    cribaPrimos[0] = falsus;
    cribaPrimos[1] = falsus;

    per (esto p : numerus = 2; (p * p) < 20; p++) {
        si (cribaPrimos[p]) {
            per (esto mult : numerus = p * p; mult < 20; mult = mult + p) {
                cribaPrimos[mult] = falsus;
            } finis;
        } finis;
    } finis;
} finis;


# =========================================================================
# 3. SECCIÓN PRINCIPAL DE EJECUCIÓN (MAIOR>)
# =========================================================================
MAIOR>

>> "==================================================";
>> ">>> ALGORITMO 1: PRODUCTO PUNTO DE VECTORES";
>> "==================================================";
>> "Vector A: [2, 4, 6, 8]";
>> "Vector B: [1, 3, 5, 7]";
esto resProd : numerus = productoPunto(4);
>> "Producto Punto (2*1 + 4*3 + 6*5 + 8*7): " >> resProd;

>> "";
>> "==================================================";
>> ">>> ALGORITMO 2: CRIBA DE ERATOSTENES (PRIMOS < 20)";
>> "==================================================";
inicializarCriba();
>> "Numeros primos encontrados entre 0 y 19:";
per (esto n : numerus = 0; n < 20; n++) {
    si (cribaPrimos[n]) {
        >> "  -> " >> n >> " es PRIMO";
    } finis;
} finis;

>> "";
>> "==================================================";
>> ">>> ALGORITMO 3: CAMBIO EXACTO DE MONEDAS (GREEDY)";
>> "==================================================";
calcularCambio(87);
calcularCambio(43);

>> "";
>> "=== ALGORITMOS Y SIMULACIONES EJECUTADOS CON ÉXITO ===";

FINIS;
